<Window x:Class="LeagueStudio.Observer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:LeagueStudio.Observer.Views.Pages"

        Title="League Studio Observer"

        Width="1200"
        Height="760"

        MinWidth="1000"
        MinHeight="650"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"

        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!-- ===================================================== -->
    <!-- League Studio Theme                                   -->
    <!-- ===================================================== -->


    <!-- ===================================================== -->
    <!-- Root                                                  -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- Sidebar                                           -->
        <!-- ================================================= -->

        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Logo / App Name -->

                <StackPanel Grid.Row="0">

                    <TextBlock
                        Text="LEAGUE STUDIO"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock
                        Text="Observer Tool"
                        FontSize="12"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel x:Name="NavigationMenu" Grid.Row="2" >

                    <TextBlock
                        Text="OPERATION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="12,0,0,8"/>


                    <!-- Active page -->

                    <Button
                        Content="Match Setup"
                        Command="{Binding ShowMatchSetupCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Foreground="{StaticResource PrimaryBrush}"
                        Background="{StaticResource PrimaryMutedBrush}"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>


                    <Button
                        Content="Live Match"
                        Command="{Binding ShowLiveMatchCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,4,0,0"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>

                    <Button
                        Content="Overrides"
                        Command="{Binding ShowOverridesCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,4,0,0"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>


                    <TextBlock
                        Text="SYSTEM"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="12,28,0,8"
                        />

                    <Button
                        Content="Settings"
                        Style="{StaticResource NavigationButtonStyle}"/>

                </StackPanel>


                <!-- Version -->

                <StackPanel Grid.Row="3">

                    <Border
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="League Studio Observer"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- Main Content                                      -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Header                                             -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding PageTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock
                            Text="{Binding PageDescription}"
                            FontSize="12"
                            Margin="0,3,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"/>

                    </StackPanel>


                    <!-- Server Status -->

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0">

                            <Ellipse.Style>
                                <Style TargetType="Ellipse">

                                    <!-- 기본값: Disconnected -->
                                    <Setter
                                        Property="Fill"
                                        Value="{StaticResource ErrorBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding ConnectionStatus}"
                                            Value="Connected">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource SuccessBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Ellipse.Style>

                        </Ellipse>

                        <TextBlock
                            Text="{Binding ConnectionStatus}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="0,0,14,0"/>

                        <Button
                            Content="Check"
                            Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,6"/>

                        <Button
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="8,0,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- Page                                               -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsMatchSetupPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                            <pages:MatchSetupView/>

            </Grid>

            <!-- ================================================= -->
            <!-- Live Match                                        -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsLiveMatchPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

            <pages:LiveMatchView
                    DataContext="{Binding LiveMatch}"/>

            </Grid>



            <!-- ================================================= -->
            <!-- Manual Overrides                                   -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsOverridesPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <pages:ManualOverridesView
                    DataContext="{Binding ManualOverrides}"/>

            </Grid>

        </Grid>

    </Grid>

</Window>
