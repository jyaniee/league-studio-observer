<Window x:Class="LeagueStudio.Observer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="League Studio Observer"

        Width="1200"
        Height="760"

        MinWidth="1000"
        MinHeight="650"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"

        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!-- ===================================================== -->
    <!-- League Studio Theme                                   -->
    <!-- ===================================================== -->


    <!-- ===================================================== -->
    <!-- Root                                                  -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- Sidebar                                           -->
        <!-- ================================================= -->

        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Logo / App Name -->

                <StackPanel Grid.Row="0">

                    <TextBlock
                        Text="LEAGUE STUDIO"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock
                        Text="Observer Tool"
                        FontSize="12"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel x:Name="NavigationMenu" Grid.Row="2" >

                    <TextBlock
                        Text="OPERATION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="12,0,0,8"/>


                    <!-- Active page -->

                    <Button
                        Content="Match Setup"
                        Command="{Binding ShowMatchSetupCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Foreground="{StaticResource PrimaryBrush}"
                        Background="{StaticResource PrimaryMutedBrush}"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>


                    <Button
                        Content="Live Match"
                        Command="{Binding ShowLiveMatchCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,4,0,0"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>

                    <Button
                        Content="Overrides"
                        Command="{Binding ShowOverridesCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,4,0,0"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>


                    <TextBlock
                        Text="SYSTEM"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="12,28,0,8"
                        />

                    <Button
                        Content="Settings"
                        Style="{StaticResource NavigationButtonStyle}"/>

                </StackPanel>


                <!-- Version -->

                <StackPanel Grid.Row="3">

                    <Border
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="League Studio Observer"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- Main Content                                      -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Header                                             -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding PageTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock
                            Text="{Binding PageDescription}"
                            FontSize="12"
                            Margin="0,3,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"/>

                    </StackPanel>


                    <!-- Server Status -->

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0">

                            <Ellipse.Style>
                                <Style TargetType="Ellipse">

                                    <!-- 기본값: Disconnected -->
                                    <Setter
                                        Property="Fill"
                                        Value="{StaticResource ErrorBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding ConnectionStatus}"
                                            Value="Connected">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource SuccessBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Ellipse.Style>

                        </Ellipse>

                        <TextBlock
                            Text="{Binding ConnectionStatus}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="0,0,14,0"/>

                        <Button
                            Content="Check"
                            Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,6"/>

                        <Button
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="8,0,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- Page                                               -->
            <!-- ================================================= -->

            <Grid Grid.Row="1" Visibility="{Binding IsMatchSetupPage, Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer
                    x:Name="MainScrollViewer"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource BackgroundBrush}"
                    ScrollChanged="MainScrollViewer_ScrollChanged">

                    <StackPanel Margin="32">


                        <!-- ================================================= -->
                        <!-- Session                                            -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Session"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>


                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- Match ID -->

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Match ID"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding MatchId}"/>

                                </StackPanel>


                                <!-- Observer ID -->

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Observer ID"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding ObserverId}"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- Match Information                                  -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Match Information"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>


                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Tournament Name"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding TournamentName}"/>

                                </StackPanel>


                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Set Number"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding SetNumber}"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- Teams                                              -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Teams"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>


                        <Grid Margin="0,0,0,24">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Blue Team -->

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BlueTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="BLUE TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BlueTeamBrush}"
                                        Margin="0,0,0,18"/>


                                    <TextBlock
                                        Text="Team Name"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueTeamName}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Team Tag"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueTeamTag}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Logo URL"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueTeamLogoUrl}"/>

                                </StackPanel>

                            </Border>


                            <!-- Red Team -->

                            <Border
                                Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource RedTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="RED TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RedTeamBrush}"
                                        Margin="0,0,0,18"/>


                                    <TextBlock
                                        Text="Team Name"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedTeamName}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Team Tag"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedTeamTag}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Logo URL"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedTeamLogoUrl}"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- Footer Actions                                     -->
                        <!-- ================================================= -->

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="Ready to apply"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock
                                        Text="{Binding ResultMessage}"
                                        FontSize="11"
                                        Margin="0,3,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"/>

                                </StackPanel>


                                <Button
                                    Grid.Column="1"
                                    Content="Apply Match Info"
                                    Command="{Binding ApplyMatchInfoCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="160"/>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>


                <!-- ================================================= -->
                <!-- Scroll Hint                                       -->
                <!-- ================================================= -->

                <Grid
                    x:Name="ScrollHint"
                    Height="60"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" Cursor="">

                    <Grid.Background>

                        <LinearGradientBrush
                            StartPoint="0,0"
                            EndPoint="0,1">

                            <GradientStop
                                Color="#000F0F14"
                                Offset="0"/>

                            <GradientStop
                                Color="#990F0F14"
                                Offset="0.45"/>

                            <GradientStop
                                Color="#FF0F0F14"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Grid.Background>


                    <Border
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,9"
                        Background="#DD1D1D28"
                        BorderBrush="#502A2938"
                        BorderThickness="1"
                        CornerRadius="15">

                        <Path
                            Data="M 4 7 L 10 13 L 16 7"
                            Stroke="{StaticResource PrimaryBrush}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="-1.5,0,1.5,0"
                            />

                    </Border>

                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- Live Match                                        -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsLiveMatchPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource BackgroundBrush}">

                    <StackPanel
                        Margin="32"
                        DataContext="{Binding LiveMatch}">

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"/>

                            </Grid>

                        </Border>

                        <StackPanel>

                            <StackPanel.Style>

                                <Style TargetType="StackPanel">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding HasMatch}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>

                            <TextBlock
                                Text="Session"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,10"/>

                            <Border
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,24">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                                            Text="Match ID"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.MatchId}"
                                            Margin="0,6,0,18"/>

                                        <TextBlock
                                            Text="Tournament Name"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.TournamentName}"
                                            Margin="0,6,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock
                                            Text="Observer ID"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.ObserverId}"
                                            Margin="0,6,0,18"/>

                                        <TextBlock
                                            Text="Set Number"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.SetNumber}"
                                            Margin="0,6,0,18"/>

                                        <TextBlock
                                            Text="Updated At"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.UpdatedAt}"
                                            Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <TextBlock
                                Text="Teams"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,10"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BlueTeamBrush}"
                                    BorderThickness="2,1,1,1"
                                    CornerRadius="8"
                                    Padding="20">

                                    <StackPanel>

                                        <TextBlock
                                            Text="BLUE TEAM"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource BlueTeamBrush}"
                                            Margin="0,0,0,14"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Blue.Name}"
                                            FontSize="18"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Blue.Tag}"
                                            Margin="0,6,0,12"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Blue.LogoUrl}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextMutedBrush}"/>

                                    </StackPanel>

                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource RedTeamBrush}"
                                    BorderThickness="2,1,1,1"
                                    CornerRadius="8"
                                    Padding="20">

                                    <StackPanel>

                                        <TextBlock
                                            Text="RED TEAM"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource RedTeamBrush}"
                                            Margin="0,0,0,14"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Red.Name}"
                                            FontSize="18"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Red.Tag}"
                                            Margin="0,6,0,12"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Red.LogoUrl}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextMutedBrush}"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <!-- Reset Match 영역                                      -->

                            <!-- ================================================= -->
                            <!-- Match Actions                                     -->
                            <!-- ================================================= -->

                            <Border
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,24,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Reset Match"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <TextBlock
                                            Text="현재 경기 정보와 Observer Override를 모두 초기화합니다."
                                            FontSize="11"
                                            Margin="0,3,0,0"
                                            Foreground="{StaticResource TextMutedBrush}"/>

                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Content="Reset Match"
                                        Click="ResetMatchButton_Click"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinWidth="120"/>

                                </Grid>

                            </Border>
                            
                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

            <!-- ================================================= -->
            <!-- Manual Overrides                                   -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsOverridesPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource BackgroundBrush}">

                    <StackPanel
                        Margin="32"
                        DataContext="{Binding ManualOverrides}">

                        <!-- Status -->

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,24">

                            <StackPanel>

                                <TextBlock
                                    Text="Override Status"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    FontSize="11"
                                    Margin="0,4,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                            </StackPanel>

                        </Border>


                        <!-- Next Dragon -->

                        <TextBlock
                            Text="Objectives"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Next Dragon"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock
                                        Text="다음에 등장할 드래곤 타입을 수동으로 지정합니다."
                                        FontSize="11"
                                        Margin="0,3,0,10"
                                        Foreground="{StaticResource TextMutedBrush}"/>

                                    <ComboBox
                                        ItemsSource="{Binding DragonTypes}"
                                        SelectedItem="{Binding SelectedDragon}"
                                        Style="{StaticResource ManualOverrideComboBoxStyle}"/>

                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Content="Apply"
                                    Command="{Binding ApplyNextDragonCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"
                                    VerticalAlignment="Bottom"/>

                            </Grid>

                        </Border>


                        <!-- Team Gold -->

                        <TextBlock
                            Text="Team Gold"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Blue -->

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BlueTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="BLUE TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BlueTeamBrush}"
                                        Margin="0,0,0,16"/>

                                    <TextBlock
                                        Text="Global Gold"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueGold,
                                            UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,14"/>

                                    <Button
                                        Content="Apply Blue Gold"
                                        Command="{Binding ApplyBlueGoldCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                </StackPanel>

                            </Border>


                            <!-- Red -->

                            <Border
                                Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource RedTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="RED TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RedTeamBrush}"
                                        Margin="0,0,0,16"/>

                                    <TextBlock
                                        Text="Global Gold"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedGold,
                                            UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,14"/>

                                    <Button
                                        Content="Apply Red Gold"
                                        Command="{Binding ApplyRedGoldCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>
