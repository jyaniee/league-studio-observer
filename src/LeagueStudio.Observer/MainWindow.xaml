<Window x:Class="LeagueStudio.Observer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="League Studio Observer"

        Width="1200"
        Height="760"

        MinWidth="1000"
        MinHeight="650"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"

        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!-- ===================================================== -->
    <!-- League Studio Theme                                   -->
    <!-- ===================================================== -->

    <Window.Resources>

        <!-- Brand -->

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#8E62F7"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#9D75FA"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#784DE8"/>

        <SolidColorBrush x:Key="PrimaryMutedBrush"
                         Color="#268E62F7"/>


        <!-- Backgrounds -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#0F0F14"/>

        <SolidColorBrush x:Key="SidebarBrush"
                         Color="#121219"/>

        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#17171F"/>

        <SolidColorBrush x:Key="SurfaceSecondaryBrush"
                         Color="#1D1D28"/>

        <SolidColorBrush x:Key="SurfaceHoverBrush"
                         Color="#232331"/>


        <!-- Borders -->

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#2A2938"/>

        <SolidColorBrush x:Key="BorderHoverBrush"
                         Color="#413B5C"/>


        <!-- Text -->

        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="#F4F2FF"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#AAA5BF"/>

        <SolidColorBrush x:Key="TextMutedBrush"
                         Color="#77738A"/>


        <!-- Status -->

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#67E8A5"/>

        <SolidColorBrush x:Key="WarningBrush"
                         Color="#F7C56B"/>

        <SolidColorBrush x:Key="ErrorBrush"
                         Color="#F47C95"/>


        <!-- Teams -->

        <SolidColorBrush x:Key="BlueTeamBrush"
                         Color="#5798FF"/>

        <SolidColorBrush x:Key="RedTeamBrush"
                         Color="#FF6682"/>


        <!-- ================================================= -->
        <!-- Default Text                                      -->
        <!-- ================================================= -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>
        </Style>


        <!-- ================================================= -->
        <!-- TextBox                                           -->
        <!-- ================================================= -->

        <Style TargetType="TextBox">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource SurfaceSecondaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,6"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            
            <Setter Property="Validation.ErrorTemplate"
                    Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                            x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="Opacity"
                                    Value="0.45"/>

                            </Trigger>

                            <Trigger Property="Validation.HasError"
                                    Value="True">

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource ErrorBrush}"/>

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="Background"
                                    Value="#18F47C95"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- Primary Button                                    -->
        <!-- ================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="16,10"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryHoverBrush}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryPressedBrush}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- Danger Button                                     -->
        <!-- ================================================= -->

        <Style x:Key="DangerButtonStyle"
       TargetType="Button">

            <Setter Property="Foreground"
            Value="{StaticResource ErrorBrush}"/>

            <Setter Property="Background"
            Value="#18F47C95"/>

            <Setter Property="BorderBrush"
            Value="{StaticResource ErrorBrush}"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="Padding"
            Value="14,8"/>

            <Setter Property="FontSize"
            Value="13"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                    x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter
                            TargetName="ButtonBorder"
                            Property="Background"
                            Value="#30F47C95"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter
                            TargetName="ButtonBorder"
                            Property="Background"
                            Value="#48F47C95"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                             Value="False">

                                <Setter
                            TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- Manual Overrides ComboBox Item                    -->
        <!-- ================================================= -->
        <Style
            x:Key="ManualOverrideComboBoxItemStyle"
            TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border
                    x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                             Value="True">
                                <Setter
                            TargetName="ItemBorder"
                            Property="Background"
                            Value="{StaticResource SurfaceSecondaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                             Value="True">
                                <Setter
                            TargetName="ItemBorder"
                            Property="Background"
                            Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- Manual Overrides ComboBox                         -->
        <!-- ================================================= -->
        <Style
            x:Key="ManualOverrideComboBoxStyle"
            TargetType="ComboBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource SurfaceSecondaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ManualOverrideComboBoxItemStyle}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- Closed ComboBox -->
                            <Border
                                x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                                <ToggleButton
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    ClickMode="Press"
                                    IsChecked="{Binding IsDropDownOpen,
                                        RelativeSource={RelativeSource AncestorType={x:Type ComboBox}},
                                        Mode=TwoWay}">

                                    <ToggleButton.Template>

                                        <ControlTemplate TargetType="ToggleButton">

                                            <Grid Background="Transparent">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter
                                                    Content="{TemplateBinding Content}"
                                                    Margin="10,0,4,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>

                                                <!-- Placeholder -->
                                                <TextBlock
                                                    x:Name="Placeholder"
                                                    Text="Select dragon..."
                                                    Margin="10,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Visibility="Collapsed"/>

                                                <!-- Arrow -->
                                                <Path
                                                    Grid.Column="1"
                                                    Width="8"
                                                    Height="5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Stroke="{StaticResource TextSecondaryBrush}"
                                                    StrokeThickness="1.5"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    Data="M 0 0 L 4 4 L 8 0"/>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding SelectedIndex,
                                                        RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    Value="-1">

                                                    <Setter
                                                        TargetName="Placeholder"
                                                        Property="Visibility"
                                                        Value="Visible"/>

                                                </DataTrigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </ToggleButton.Template>

                                </ToggleButton>

                            </Border>


                            <!-- Drop-down -->
                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Focusable="False"
                                PopupAnimation="Fade">

                                <Border
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="240"
                                    Margin="0,4,0,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <ScrollViewer
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter
                                    TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                    Value="True">
                                <Setter
                                    TargetName="MainBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter
                                    TargetName="MainBorder"
                                    Property="Opacity"
                                    Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ================================================= -->
        <!-- Navigation Button                                 -->
        <!-- ================================================= -->

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="13,10"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="NavigationBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="NavigationBorder"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource TextPrimaryBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="NavigationBorder"
                                    Property="Background"
                                    Value="{StaticResource PrimaryMutedBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- Close Button                                      -->
        <!-- ================================================= -->

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="CloseBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#3B202A"/>

                                <Setter
                                    Property="Foreground"
                                    Value="#FF8EA3"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="CloseBorder"
                                    Property="Background"
                                    Value="#582533"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- Root                                                  -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- Sidebar                                           -->
        <!-- ================================================= -->

        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Logo / App Name -->

                <StackPanel Grid.Row="0">

                    <TextBlock
                        Text="LEAGUE STUDIO"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock
                        Text="Observer Tool"
                        FontSize="12"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel x:Name="NavigationMenu" Grid.Row="2" >

                    <TextBlock
                        Text="OPERATION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="12,0,0,8"/>


                    <!-- Active page -->

                    <Button
                        Content="Match Setup"
                        Command="{Binding ShowMatchSetupCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Foreground="{StaticResource PrimaryBrush}"
                        Background="{StaticResource PrimaryMutedBrush}"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>


                    <Button
                        Content="Live Match"
                        Command="{Binding ShowLiveMatchCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,4,0,0"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>

                    <Button
                        Content="Overrides"
                        Command="{Binding ShowOverridesCommand}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Margin="0,4,0,0"
                        PreviewMouseLeftButtonDown="NavigationButton_PreviewMouseLeftButtonDown"/>


                    <TextBlock
                        Text="SYSTEM"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="12,28,0,8"
                        />

                    <Button
                        Content="Settings"
                        Style="{StaticResource NavigationButtonStyle}"/>

                </StackPanel>


                <!-- Version -->

                <StackPanel Grid.Row="3">

                    <Border
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,0,0,14"/>

                    <TextBlock
                        Text="League Studio Observer"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- Main Content                                      -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Header                                             -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding PageTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock
                            Text="{Binding PageDescription}"
                            FontSize="12"
                            Margin="0,3,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"/>

                    </StackPanel>


                    <!-- Server Status -->

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0">

                            <Ellipse.Style>
                                <Style TargetType="Ellipse">

                                    <!-- 기본값: Disconnected -->
                                    <Setter
                                        Property="Fill"
                                        Value="{StaticResource ErrorBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding ConnectionStatus}"
                                            Value="Connected">

                                            <Setter
                                                Property="Fill"
                                                Value="{StaticResource SuccessBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Ellipse.Style>

                        </Ellipse>

                        <TextBlock
                            Text="{Binding ConnectionStatus}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="0,0,14,0"/>

                        <Button
                            Content="Check"
                            Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,6"/>

                        <Button
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="8,0,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- Page                                               -->
            <!-- ================================================= -->

            <Grid Grid.Row="1" Visibility="{Binding IsMatchSetupPage, Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer
                    x:Name="MainScrollViewer"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource BackgroundBrush}"
                    ScrollChanged="MainScrollViewer_ScrollChanged">

                    <StackPanel Margin="32">


                        <!-- ================================================= -->
                        <!-- Session                                            -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Session"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>


                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- Match ID -->

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Match ID"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding MatchId}"/>

                                </StackPanel>


                                <!-- Observer ID -->

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Observer ID"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding ObserverId}"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- Match Information                                  -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Match Information"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>


                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Tournament Name"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding TournamentName}"/>

                                </StackPanel>


                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Set Number"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding SetNumber}"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- Teams                                              -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Teams"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>


                        <Grid Margin="0,0,0,24">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Blue Team -->

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BlueTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="BLUE TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BlueTeamBrush}"
                                        Margin="0,0,0,18"/>


                                    <TextBlock
                                        Text="Team Name"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueTeamName}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Team Tag"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueTeamTag}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Logo URL"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueTeamLogoUrl}"/>

                                </StackPanel>

                            </Border>


                            <!-- Red Team -->

                            <Border
                                Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource RedTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="RED TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RedTeamBrush}"
                                        Margin="0,0,0,18"/>


                                    <TextBlock
                                        Text="Team Name"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedTeamName}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Team Tag"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedTeamTag}"
                                        Margin="0,0,0,14"/>


                                    <TextBlock
                                        Text="Logo URL"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedTeamLogoUrl}"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- Footer Actions                                     -->
                        <!-- ================================================= -->

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="Ready to apply"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock
                                        Text="{Binding ResultMessage}"
                                        FontSize="11"
                                        Margin="0,3,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"/>

                                </StackPanel>


                                <Button
                                    Grid.Column="1"
                                    Content="Apply Match Info"
                                    Command="{Binding ApplyMatchInfoCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="160"/>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>


                <!-- ================================================= -->
                <!-- Scroll Hint                                       -->
                <!-- ================================================= -->

                <Grid
                    x:Name="ScrollHint"
                    Height="60"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" Cursor="">

                    <Grid.Background>

                        <LinearGradientBrush
                            StartPoint="0,0"
                            EndPoint="0,1">

                            <GradientStop
                                Color="#000F0F14"
                                Offset="0"/>

                            <GradientStop
                                Color="#990F0F14"
                                Offset="0.45"/>

                            <GradientStop
                                Color="#FF0F0F14"
                                Offset="1"/>

                        </LinearGradientBrush>

                    </Grid.Background>


                    <Border
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,9"
                        Background="#DD1D1D28"
                        BorderBrush="#502A2938"
                        BorderThickness="1"
                        CornerRadius="15">

                        <Path
                            Data="M 4 7 L 10 13 L 16 7"
                            Stroke="{StaticResource PrimaryBrush}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="-1.5,0,1.5,0"
                            />

                    </Border>

                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- Live Match                                        -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsLiveMatchPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource BackgroundBrush}">

                    <StackPanel
                        Margin="32"
                        DataContext="{Binding LiveMatch}">

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"/>

                            </Grid>

                        </Border>

                        <StackPanel>

                            <StackPanel.Style>

                                <Style TargetType="StackPanel">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding HasMatch}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>

                            <TextBlock
                                Text="Session"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,10"/>

                            <Border
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,24">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                                            Text="Match ID"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.MatchId}"
                                            Margin="0,6,0,18"/>

                                        <TextBlock
                                            Text="Tournament Name"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.TournamentName}"
                                            Margin="0,6,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock
                                            Text="Observer ID"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.ObserverId}"
                                            Margin="0,6,0,18"/>

                                        <TextBlock
                                            Text="Set Number"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.SetNumber}"
                                            Margin="0,6,0,18"/>

                                        <TextBlock
                                            Text="Updated At"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.UpdatedAt}"
                                            Margin="0,6,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <TextBlock
                                Text="Teams"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,10"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BlueTeamBrush}"
                                    BorderThickness="2,1,1,1"
                                    CornerRadius="8"
                                    Padding="20">

                                    <StackPanel>

                                        <TextBlock
                                            Text="BLUE TEAM"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource BlueTeamBrush}"
                                            Margin="0,0,0,14"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Blue.Name}"
                                            FontSize="18"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Blue.Tag}"
                                            Margin="0,6,0,12"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Blue.LogoUrl}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextMutedBrush}"/>

                                    </StackPanel>

                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource RedTeamBrush}"
                                    BorderThickness="2,1,1,1"
                                    CornerRadius="8"
                                    Padding="20">

                                    <StackPanel>

                                        <TextBlock
                                            Text="RED TEAM"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource RedTeamBrush}"
                                            Margin="0,0,0,14"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Red.Name}"
                                            FontSize="18"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Red.Tag}"
                                            Margin="0,6,0,12"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>

                                        <TextBlock
                                            Text="{Binding CurrentState.Teams.Red.LogoUrl}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextMutedBrush}"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <!-- Reset Match 영역                                      -->

                            <!-- ================================================= -->
                            <!-- Match Actions                                     -->
                            <!-- ================================================= -->

                            <Border
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,24,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Reset Match"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <TextBlock
                                            Text="현재 경기 정보와 Observer Override를 모두 초기화합니다."
                                            FontSize="11"
                                            Margin="0,3,0,0"
                                            Foreground="{StaticResource TextMutedBrush}"/>

                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Content="Reset Match"
                                        Click="ResetMatchButton_Click"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinWidth="120"/>

                                </Grid>

                            </Border>
                            
                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

            <!-- ================================================= -->
            <!-- Manual Overrides                                   -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsOverridesPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource BackgroundBrush}">

                    <StackPanel
                        Margin="32"
                        DataContext="{Binding ManualOverrides}">

                        <!-- Status -->

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,24">

                            <StackPanel>

                                <TextBlock
                                    Text="Override Status"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    FontSize="11"
                                    Margin="0,4,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                            </StackPanel>

                        </Border>


                        <!-- Next Dragon -->

                        <TextBlock
                            Text="Objectives"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>

                        <Border
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Next Dragon"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock
                                        Text="다음에 등장할 드래곤 타입을 수동으로 지정합니다."
                                        FontSize="11"
                                        Margin="0,3,0,10"
                                        Foreground="{StaticResource TextMutedBrush}"/>

                                    <ComboBox
                                        ItemsSource="{Binding DragonTypes}"
                                        SelectedItem="{Binding SelectedDragon}"
                                        Style="{StaticResource ManualOverrideComboBoxStyle}"/>

                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Content="Apply"
                                    Command="{Binding ApplyNextDragonCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"
                                    VerticalAlignment="Bottom"/>

                            </Grid>

                        </Border>


                        <!-- Team Gold -->

                        <TextBlock
                            Text="Team Gold"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Blue -->

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BlueTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="BLUE TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BlueTeamBrush}"
                                        Margin="0,0,0,16"/>

                                    <TextBlock
                                        Text="Global Gold"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding BlueGold,
                                            UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,14"/>

                                    <Button
                                        Content="Apply Blue Gold"
                                        Command="{Binding ApplyBlueGoldCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                </StackPanel>

                            </Border>


                            <!-- Red -->

                            <Border
                                Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource RedTeamBrush}"
                                BorderThickness="2,1,1,1"
                                CornerRadius="8"
                                Padding="20">

                                <StackPanel>

                                    <TextBlock
                                        Text="RED TEAM"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource RedTeamBrush}"
                                        Margin="0,0,0,16"/>

                                    <TextBlock
                                        Text="Global Gold"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Margin="0,0,0,6"/>

                                    <TextBox
                                        Text="{Binding RedGold,
                                            UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,14"/>

                                    <Button
                                        Content="Apply Red Gold"
                                        Command="{Binding ApplyRedGoldCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>
