<Window x:Class="LeagueStudio.Observer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:LeagueStudio.Observer.Views.Pages"
        xmlns:shared="clr-namespace:LeagueStudio.Observer.Views.Shared"

        Title="League Studio Observer"

        Width="1200"
        Height="760"

        MinWidth="1000"
        MinHeight="650"

        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"

        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!-- ===================================================== -->
    <!-- League Studio Theme                                   -->
    <!-- ===================================================== -->


    <!-- ===================================================== -->
    <!-- Root                                                  -->
    <!-- ===================================================== -->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- Sidebar                                           -->
        <!-- ================================================= -->

        <shared:SidebarView
             Grid.Column="0"/>


        <!-- ================================================= -->
        <!-- Main Content                                      -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- Header                                             -->
            <!-- ================================================= -->

            <shared:HeaderView
                     Grid.Row="0"/>


            <!-- ================================================= -->
            <!-- MatchSetup                                          -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsMatchSetupPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                            <pages:MatchSetupView/>

            </Grid>

            <!-- ================================================= -->
            <!-- Live Match                                        -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsLiveMatchPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

            <pages:LiveMatchView
                    DataContext="{Binding LiveMatch}"/>

            </Grid>



            <!-- ================================================= -->
            <!-- Manual Overrides                                   -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Visibility="{Binding IsOverridesPage,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <pages:ManualOverridesView
                    DataContext="{Binding ManualOverrides}"/>

            </Grid>

        </Grid>

    </Grid>

</Window>
