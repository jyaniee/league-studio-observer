<Window x:Class="LeagueStudio.Observer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="League Studio Observer"
        Height="500"
        Width="600">

    <StackPanel Margin="24">

        <TextBlock
            Text="League Studio Observer"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,24" />

        <!-- Server -->
        <TextBlock
            Text="Server"
            FontSize="18"
            FontWeight="SemiBold" />

        <StackPanel
            Orientation="Horizontal"
            Margin="0,8,0,20">

            <TextBlock
                Text="Status:"
                Margin="0,0,8,0" />

            <TextBlock
                Text="{Binding ConnectionStatus}" />

        </StackPanel>

        <Button
            Content="Check Connection"
            Command="{Binding CheckConnectionCommand}"
            Width="160"
            HorizontalAlignment="Left"
            Margin="0,0,0,24" />

        <!-- Match -->
        <TextBlock
            Text="Match"
            FontSize="18"
            FontWeight="SemiBold" />

        <TextBlock
            Text="Match ID"
            Margin="0,8,0,4" />

        <TextBox
            Text="{Binding MatchId}"
            Width="250"
            HorizontalAlignment="Left" />

        <TextBlock
            Text="Observer ID"
            Margin="0,12,0,4" />

        <TextBox
            Text="{Binding ObserverId}"
            Width="250"
            HorizontalAlignment="Left" />

        <!-- Dragon -->
        <TextBlock
            Text="Next Dragon"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,24,0,8" />

        <ComboBox
            ItemsSource="{Binding DragonTypes}"
            SelectedItem="{Binding SelectedDragon}"
            Width="250"
            HorizontalAlignment="Left" />

        <Button
            Content="Apply Dragon"
            Command="{Binding ApplyDragonCommand}"
            Width="160"
            HorizontalAlignment="Left"
            Margin="0,12,0,16" />

        <!-- Result -->
        <TextBlock
            Text="{Binding ResultMessage}"
            TextWrapping="Wrap" />

    </StackPanel>

</Window>