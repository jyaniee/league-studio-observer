<UserControl x:Class="LeagueStudio.Observer.Views.Pages.MatchSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <ScrollViewer
            x:Name="MainScrollViewer"
            VerticalScrollBarVisibility="Hidden"
            HorizontalScrollBarVisibility="Disabled"
            Background="{StaticResource BackgroundBrush}"
            ScrollChanged="MainScrollViewer_ScrollChanged">

            <StackPanel Margin="32">

                <!-- Session -->

                <TextBlock
                    Text="Session"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="0,0,0,10"/>

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,24">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Match ID"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding MatchId}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Observer ID"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding ObserverId}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Match Information -->

                <TextBlock
                    Text="Match Information"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="0,0,0,10"/>

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,24">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Tournament Name"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding TournamentName}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Set Number"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding SetNumber}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Teams -->

                <TextBlock
                    Text="Teams"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Blue Team -->

                    <Border
                        Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BlueTeamBrush}"
                        BorderThickness="2,1,1,1"
                        CornerRadius="8"
                        Padding="20">

                        <StackPanel>

                            <TextBlock
                                Text="BLUE TEAM"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource BlueTeamBrush}"
                                Margin="0,0,0,18"/>

                            <TextBlock
                                Text="Team Name"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding BlueTeamName}"
                                Margin="0,0,0,14"/>

                            <TextBlock
                                Text="Team Tag"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding BlueTeamTag}"
                                Margin="0,0,0,14"/>

                            <TextBlock
                                Text="Logo URL"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding BlueTeamLogoUrl}"/>

                        </StackPanel>

                    </Border>


                    <!-- Red Team -->

                    <Border
                        Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource RedTeamBrush}"
                        BorderThickness="2,1,1,1"
                        CornerRadius="8"
                        Padding="20">

                        <StackPanel>

                            <TextBlock
                                Text="RED TEAM"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource RedTeamBrush}"
                                Margin="0,0,0,18"/>

                            <TextBlock
                                Text="Team Name"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding RedTeamName}"
                                Margin="0,0,0,14"/>

                            <TextBlock
                                Text="Team Tag"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding RedTeamTag}"
                                Margin="0,0,0,14"/>

                            <TextBlock
                                Text="Logo URL"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,0,6"/>

                            <TextBox
                                Text="{Binding RedTeamLogoUrl}"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- Footer Actions -->

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Ready to apply"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock
                                Text="{Binding ResultMessage}"
                                FontSize="11"
                                Margin="0,3,0,0"
                                Foreground="{StaticResource TextMutedBrush}"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Apply Match Info"
                            Command="{Binding ApplyMatchInfoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="160"/>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- Scroll Hint -->

        <Grid
            x:Name="ScrollHint"
            Height="60"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Visibility="Collapsed"
            Cursor="">

            <Grid.Background>

                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">

                    <GradientStop
                        Color="#000F0F14"
                        Offset="0"/>

                    <GradientStop
                        Color="#990F0F14"
                        Offset="0.45"/>

                    <GradientStop
                        Color="#FF0F0F14"
                        Offset="1"/>

                </LinearGradientBrush>

            </Grid.Background>

            <Border
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,9"
                Background="#DD1D1D28"
                BorderBrush="#502A2938"
                BorderThickness="1"
                CornerRadius="15">

                <Path
                    Data="M 4 7 L 10 13 L 16 7"
                    Stroke="{StaticResource PrimaryBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="-1.5,0,1.5,0"/>

            </Border>

        </Grid>

    </Grid>

</UserControl>