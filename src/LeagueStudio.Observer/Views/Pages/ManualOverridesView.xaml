<UserControl x:Class="LeagueStudio.Observer.Views.Pages.ManualOverridesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Background="{StaticResource BackgroundBrush}">

        <StackPanel Margin="32">

            <!-- Status -->

            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,24">

                <StackPanel>

                    <TextBlock
                        Text="Override Status"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock
                        Text="{Binding StatusMessage}"
                        FontSize="11"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                </StackPanel>

            </Border>


            <!-- Next Dragon -->

            <TextBlock
                Text="Objectives"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Margin="0,0,0,10"/>


            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,24">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="Next Dragon"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock
                            Text="다음에 등장할 드래곤 타입을 수동으로 지정합니다."
                            FontSize="11"
                            Margin="0,3,0,10"
                            Foreground="{StaticResource TextMutedBrush}"/>

                        <ComboBox
                            ItemsSource="{Binding DragonTypes}"
                            SelectedItem="{Binding SelectedDragon}"
                            Style="{StaticResource ManualOverrideComboBoxStyle}"/>

                    </StackPanel>


                    <Button
                        Grid.Column="2"
                        Content="Apply"
                        Command="{Binding ApplyNextDragonCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="100"
                        VerticalAlignment="Bottom"/>

                </Grid>

            </Border>


            <!-- Team Gold -->

            <TextBlock
                Text="Team Gold"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Margin="0,0,0,10"/>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Blue -->

                <Border
                    Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BlueTeamBrush}"
                    BorderThickness="2,1,1,1"
                    CornerRadius="8"
                    Padding="20">

                    <StackPanel>

                        <TextBlock
                            Text="BLUE TEAM"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource BlueTeamBrush}"
                            Margin="0,0,0,16"/>

                        <TextBlock
                            Text="Global Gold"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="0,0,0,6"/>

                        <TextBox
                            Text="{Binding BlueGold,
                                UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,14"/>

                        <Button
                            Content="Apply Blue Gold"
                            Command="{Binding ApplyBlueGoldCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    </StackPanel>

                </Border>


                <!-- Red -->

                <Border
                    Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource RedTeamBrush}"
                    BorderThickness="2,1,1,1"
                    CornerRadius="8"
                    Padding="20">

                    <StackPanel>

                        <TextBlock
                            Text="RED TEAM"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource RedTeamBrush}"
                            Margin="0,0,0,16"/>

                        <TextBlock
                            Text="Global Gold"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Margin="0,0,0,6"/>

                        <TextBox
                            Text="{Binding RedGold,
                                UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,14"/>

                        <Button
                            Content="Apply Red Gold"
                            Command="{Binding ApplyRedGoldCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</UserControl>